<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainNavigation"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.cepapplication.SearchFragment"
        android:label="@string/toolbar_title">
        <action
            android:id="@+id/action_searchFragment_to_savedAddressesFragment"
            app:destination="@id/savedAddressesFragment" />
    </fragment>

    <fragment
        android:id="@+id/savedAddressesFragment"
        android:name="com.example.cepapplication.SavedAddressesFragment"
        android:label="@string/stored_zip_codes_title" />

</navigation>
